{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multica.local/schemas/external-signal.schema.json",
  "title": "External Signal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "source_type", "locator", "captured_at", "observed_at", "summary", "reliability", "content_hash"],
  "properties": {
    "schema_version": {"const": "1.0"}, "kind": {"const": "external_signal"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"}, "source_type": {"type": "string", "minLength": 1},
    "locator": {"type": "string", "minLength": 1}, "captured_at": {"type": "string", "format": "date-time"}, "observed_at": {"type": "string", "format": "date-time"},
    "summary": {"type": "string", "minLength": 1}, "reliability": {"enum": ["authoritative", "corroborated", "unverified", "disputed"]},
    "content_hash": {"type": "string", "minLength": 1}, "notes": {"type": "string"}
  }
}

