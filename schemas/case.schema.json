{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multica Case V1.1",
  "description": "Historical reference memory with explicit scenario boundaries. Low authority; conditional activation only. Lifecycle: active/review_needed only.",
  "type": "object",
  "required": ["schema_version", "kind", "id", "title", "scope", "status", "verification", "context", "problem_or_trigger", "action_or_behavior", "outcome", "why_it_matters", "applicable_when", "not_applicable_when", "relevant_roles", "domains", "source_refs", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "1.1" },
    "kind": { "const": "case" },
    "id": { "$ref": "rule.schema.json#/$defs/object_id" },
    "legacy_ids": { "type": "array", "items": { "type": "string" } },
    "title": { "type": "string" },
    "scope": { "$ref": "evidence-ref.schema.json#/$defs/scope" },
    "status": { "enum": ["active", "review_needed"] },
    "verification": { "$ref": "evidence-ref.schema.json#/$defs/verification" },
    "verification_note": { "type": ["string", "null"] },
    "context": { "type": "string" },
    "problem_or_trigger": { "type": "string" },
    "action_or_behavior": { "type": "string" },
    "outcome": { "type": "string" },
    "why_it_matters": { "type": "string" },
    "applicable_when": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "not_applicable_when": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "relevant_roles": { "type": "array", "items": { "$ref": "project-registry.schema.json#/$defs/role_id" } },
    "domains": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "source_refs": { "type": "array", "items": { "$ref": "evidence-ref.schema.json#/$defs/ref_string" }, "minItems": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
