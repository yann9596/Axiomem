{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multica Project Anchor V1.1",
  "description": "Project governance baseline (project.yaml). Governance fields carry Authority semantics; context fields are evidence-maintained facts.",
  "type": "object",
  "required": ["schema_version", "kind", "project_id", "status", "governance", "context", "authority_refs", "updated_at"],
  "properties": {
    "schema_version": { "const": "1.1" },
    "kind": { "const": "project_anchor" },
    "project_id": { "$ref": "project-registry.schema.json#/$defs/project_id" },
    "status": { "enum": ["active", "review_needed"] },
    "governance": {
      "type": "object",
      "required": ["mission", "target_users", "scope", "non_goals", "hard_constraints"],
      "properties": {
        "mission": { "type": "string" },
        "target_users": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "non_goals": { "type": "array", "items": { "type": "string" } },
        "hard_constraints": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["repo_id", "role"],
            "properties": {
              "repo_id": { "type": "string" },
              "role": { "type": "string" },
              "local_path": { "type": "string" }
            }
          }
        },
        "major_domains": { "type": "array", "items": { "type": "string" } },
        "repository_relationships": { "type": "array", "items": { "type": "string" } },
        "external_dependency_refs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "authority_refs": { "type": "array", "items": { "$ref": "evidence-ref.schema.json#/$defs/ref_string" }, "minItems": 1 },
    "source_refs": { "type": "array", "items": { "$ref": "evidence-ref.schema.json#/$defs/ref_string" } },
    "review": {
      "type": "object",
      "properties": {
        "reason": { "type": ["string", "null"] },
        "triggered_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
