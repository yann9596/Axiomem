{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V1.1 Gate C replay expectation freeze lock",
  "description": "Immutable pre-run record of expectation file hashes. Path: migration/replay-expectation.lock.yaml. Must be committed in a revision that predates Gate C result generation. Missing lock is fail-closed.",
  "type": "object",
  "required": ["schema_version", "kind", "files"],
  "properties": {
    "schema_version": { "const": "1.1" },
    "kind": { "const": "replay_expectation_lock" },
    "committed_at_revision": { "type": "string" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
