{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multica.local/schemas/memory-candidate.schema.json",
  "title": "Memory Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "proposed_title", "proposed_content", "dedupe_key", "classification", "importance", "confidence", "source_ids", "status", "captured_at"],
  "properties": {
    "schema_version": {"const": "1.0"}, "kind": {"const": "memory_candidate"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "proposed_title": {"type": "string", "minLength": 1}, "proposed_content": {"type": "string", "minLength": 1},
    "dedupe_key": {"type": "string", "minLength": 1},
    "classification": {"enum": ["project", "team", "task", "role", "decision"]},
    "importance": {"type": "integer", "minimum": 1, "maximum": 5}, "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "relationships": {"type": "array", "items": {"type": "object"}},
    "possible_conflicts": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["candidate", "rejected", "promoted"]},
    "captured_at": {"type": "string", "format": "date-time"}, "reviewed_at": {"type": ["string", "null"], "format": "date-time"}, "review_note": {"type": "string"}
  }
}

