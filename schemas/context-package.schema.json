{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multica.local/schemas/context-package.schema.json",
  "title": "Context Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "task_id", "role", "decision", "known_facts", "relevant_memory", "confidence", "conflicts", "missing_context", "memory_candidates", "generated_at"],
  "properties": {
    "schema_version": {"const": "1.0"}, "kind": {"const": "context_package"}, "task_id": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1}, "decision": {"type": "string", "minLength": 1},
    "known_facts": {"type": "array", "items": {"type": "object", "required": ["fact", "source", "confidence"], "properties": {"fact": {"type": "string"}, "source": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "relevant_memory": {"type": "array", "items": {"type": "object", "required": ["memory_id", "reason"], "properties": {"memory_id": {"type": "string"}, "reason": {"type": "string"}}}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "conflicts": {"type": "array", "items": {"type": "string"}}, "missing_context": {"type": "array", "items": {"type": "string"}}, "memory_candidates": {"type": "array", "items": {"type": "string"}}, "generated_at": {"type": "string", "format": "date-time"}
  }
}

