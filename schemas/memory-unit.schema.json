{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multica.local/schemas/memory-unit.schema.json",
  "title": "Memory Unit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "title", "summary", "content", "status", "scope", "importance", "confidence", "tags", "relationships", "sources", "created_at", "updated_at", "verified_at", "verified_by"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "memory_unit"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "content": {"type": "string", "minLength": 1},
    "status": {"enum": ["canonical", "superseded", "deprecated"]},
    "scope": {"enum": ["project", "team", "task", "role", "decision"]},
    "importance": {"type": "integer", "minimum": 1, "maximum": 5},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "relationships": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["type", "target_id"], "properties": {"type": {"enum": ["supports", "conflicts_with", "supersedes", "depends_on", "related_to"]}, "target_id": {"type": "string"}, "note": {"type": "string"}}}},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "verified_at": {"type": "string", "format": "date-time"},
    "verified_by": {"const": "Context Engineer"}
  }
}

