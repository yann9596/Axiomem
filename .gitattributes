# YZT-43: byte-stability for hash-locked migration evidence.
# The replay expectation lock (migration/replay-expectation.lock.yaml) and the
# per-object inventory evidence record SHA-256 over exact file bytes. Line-
# ending conversion on checkout (core.autocrlf) would make clean-checkout
# bytes differ from the locked/recorded hashes, so these paths are pinned
# binary (-text): git stores and checks out their bytes verbatim.
migration/replay/*.yaml -text
migration/replay-evidence/*.yaml -text
migration/replay-expectation.lock.yaml -text
migration/legacy-inventory.yaml -text
migration/legacy-inventory-evidence.yaml -text
memory/*.json -text
chains/*.json -text
sources/*.json -text
sources/candidates/*.json -text
# YZT-63: byte-stability for the T08 captured live-state fixtures and staged
# instruction-contract bundles (instruction digests are re-verified offline).
adapters/multica/agent-instructions/** -text
# YZT-69: byte-stability for the V2 agent-UUID→role binding evidence (live
# platform roster capture; binding validator cross-checks file bytes).
adapters/multica/role-bindings/** -text
# YZT-74: byte-stability for U05 skill bundle digests hashed by
# chandoff_instructions.digest_skill_dir (U04 shared skill + staged 05/06
# capability skills). core.autocrlf would otherwise change SKILL.md bytes
# on Windows checkout and fail the U05 pin.
skills/delivery-review/** -text
skills/product-quality-gate/** -text
skills/multica-context-handoff/** -text
adapters/multica/assignment-handoff/** -text
# YZT-75: byte-stability for U07 mention evidence hashed in the U07 report.
adapters/multica/mention-handoff/** -text
# YZT-76: byte-stability for U08 fallback evidence hashed in the U08 report.
adapters/multica/assignment-fallback/** -text
# YZT-77: byte-stability for U09 Finding/Challenge evidence (deterministic
# bundle regeneration is asserted byte-for-byte in the focused tests).
adapters/multica/finding-challenge/** -text
